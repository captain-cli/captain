{
  "name": "@captain/manifest",
  "version": "0.2.0",
  "description": "Captain orchestration engine for project manifests, builds, staging, native packaging, system readiness, and publishing.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "keywords": [
    "manifest",
    "versioning",
    "monolith",
    "monorepo",
    "cli",
    "release",
    "bump",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js"
    }
  },
  "bin": {
    "captain": "./dist/cli.js"
  },
  "dependencies": {
    "commander": "12.1.0"
  }
}
